# ═══════════════════════════════════════════════════════════════
# Criterion QA v3 — config/.env.example
# Copy this to config/.env and fill in your keys
# ═══════════════════════════════════════════════════════════════

# ── DEEPGRAM (required) ─────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── LLM via OpenRouter ───────────────────────────────────────────
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3-haiku

# ── LLM Fallbacks ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# ── Slack Notifications ──────────────────────────────────────────
AGENT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SYSTEM_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── Email Notifications (Resend) ─────────────────────────────────
RESEND_API_KEY=re_your_resend_key_here
ALERT_EMAIL_FROM=alerts@yourdomain.com
AGENT_EMAIL_TO=qa-supervisor@yourcompany.com
SYSTEM_EMAIL_TO=devops@yourcompany.com
ALERT_THROTTLE_MINUTES=5

# ── Supabase (leave blank to use SQLite locally) ─────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Performance ──────────────────────────────────────────────────
BATCH_WORKERS=20
LOG_LEVEL=INFO

# ── Flask ────────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=generate-a-random-secret-key-here
PORT=5000
